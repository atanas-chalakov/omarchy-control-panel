post_install() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi

    echo "==> omarchy-control-panel installed successfully!"
    echo "==> Launch with 'omarchy-control-panel' from terminal or application launcher."
}

post_upgrade() {
    post_install
}

post_remove() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
}
